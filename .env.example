# =============================================================================
# AlphaSentinel - environment template. Copy to .env and fill in.
# NEVER commit .env. Values are read once at process start via os.getenv().
# =============================================================================

# --- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
DEMO_MODE=true                      # true => no outbound LLM calls, scripted agents
DEFAULT_CHAIN=ethereum

# --- LLM dual-agent engine ----------------------------------------------------
# Any OpenAI-compatible endpoint works. Pick a provider preset, then override the
# models/prices if you want something else:
#   deepseek   api.deepseek.com          deepseek-chat / deepseek-reasoner
#   openai     api.openai.com/v1         gpt-4o-mini   / gpt-4o
#   anthropic  api.anthropic.com/v1      claude-sonnet-4-5 (OpenAI-compat layer)
#   openrouter openrouter.ai/api/v1      deepseek/deepseek-chat / deepseek/deepseek-r1
#   custom     set LLM_BASE_URL yourself (vLLM, Ollama, Together, Groq, gateway)
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://api.openai.com/v1          # defaults to the preset
# Overrides only - uncomment to change; each preset already supplies both models.
# ALPHA_MODEL=deepseek-chat      # Agent 1 - bull-case analyst, sees the prior
# RISK_MODEL=deepseek-reasoner   # Agent 2 - adversarial auditor (has VETO power)
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4
# USD per 1M tokens, used only for the cost ledger (verify against your invoice).
# Uncomment only if your provider's prices differ from the preset.
# LLM_INPUT_USD_PER_MTOK=0.27
# LLM_OUTPUT_USD_PER_MTOK=1.10
# Hard spend ceilings in USD; empty/0 means no ceiling. The client refuses a
# request that would cross one and the cycle stops with an explicit error rather
# than filing fake risk vetoes, so an unattended daemon cannot run up a bill.
# Requires the prices above (preset or explicit) - otherwise the ceiling could
# never bind, and validation refuses to boot.
# LLM_MAX_USD_PER_CYCLE=0.50
# LLM_MAX_USD_PER_DAY=5.00

# --- Learned alpha scorer (optional, see ml/) --------------------------------
# Who is authoritative for the alpha score. `llm` is the historical two-agent
# flow; `model` uses a trained artefact and escalates to the LLM only when a
# prediction is unsafe; `prior` never calls the LLM for alpha at all.
# ALPHA_PREDICTOR=llm
# ALPHA_MODEL_PATH=./models/alpha_model.pkl
# Run the model next to the LLM without letting it decide, to measure agreement
# on live traffic before switching ALPHA_PREDICTOR over. Needs a model file.
# ALPHA_SHADOW=false
# Escalate when a prediction is within this many points of a decision boundary
# (65 approval / 50 watch), or when input trust falls below MIN_CONFIDENCE.
# ALPHA_ESCALATE_MARGIN=5.0
# ALPHA_MIN_CONFIDENCE=0.6
# One training row per completed audit (features + labels, for later training).
# ML_WRITE_TRAINING_ROWS=true
# Legacy names are still read when the LLM_* one is absent: DEEPSEEK_API_KEY,
# DEEPSEEK_BASE_URL, DEEPSEEK_TIMEOUT_SECONDS, DEEPSEEK_MAX_RETRIES,
# DEEPSEEK_MAX_CONCURRENCY, DEEPSEEK_INPUT_USD_PER_MTOK, DEEPSEEK_OUTPUT_USD_PER_MTOK.

# --- Storage -----------------------------------------------------------------
DATA_DIR=./data
HOT_DB_PATH=./data/hot/alpha_sentinel.db
PARQUET_ROOT=./data/cold
PARQUET_COMPRESSION=zstd
PARQUET_ROW_GROUP_SIZE=262144
# Retention windows, in days. 0 keeps that dataset forever (never pruned).
LOCAL_RETENTION_DAYS=90
REMOTE_RETENTION_DAYS=365
# training_rows is a corpus, not an ops log: 3 years by default, so the window
# that trims verdicts cannot delete the data a model is trained on.
TRAINING_RETENTION_DAYS=1095

# --- Cloudflare R2 (S3-compatible, optional) ---------------------------------
R2_ENABLED=false
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=alpha-sentinel-cold
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=alpha-sentinel
R2_REGION=auto

# --- Vendor endpoints (the whole URL is configuration) -----------------------
# Every outbound URL lives in config/endpoints.yaml, not in code. Three ways to
# change it, in increasing priority:
#
#   1. ENDPOINTS_FILE=/etc/alphasentinel/endpoints.yaml
#      a mounted ConfigMap/secret (same shape as config/endpoints.yaml) merged
#      over the bundled catalogue - list only what this deployment changes.
#   2. <VENDOR>_BASE_URL     move every endpoint of one vendor (mirror, gateway).
#   3. <VENDOR>_<NAME>_URL   replace one endpoint with a full absolute URL.
#
# Uncomment only what you need to move; the public host is the default.
# ENDPOINTS_FILE=/etc/alphasentinel/endpoints.yaml
#
# Per-vendor bases:
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
# DEXSCREENER_BASE_URL=https://api.dexscreener.com
# YAHOO_BASE_URL=https://query1.finance.yahoo.com
# DEFILLAMA_BASE_URL=https://api.llama.fi
# GROWTHEPIE_BASE_URL=https://api.growthepie.com/v1
# FEAR_GREED_BASE_URL=https://api.alternative.me
# SEC_FILES_BASE_URL=https://www.sec.gov        # company_tickers.json
# SEC_BASE_URL=https://data.sec.gov             # XBRL companyfacts
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BYBIT_BASE_URL=https://api.bybit.com
# HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
# COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
# ARKHAM_BASE_URL=https://api.arkhamintelligence.com
# NANSEN_BASE_URL=https://api.nansen.ai
# DUNE_BASE_URL=https://api.dune.com
# X_API_BASE_URL=https://api.x.com
# CRYPTOPANIC_BASE_URL=https://cryptopanic.com
# LUNARCRUSH_BASE_URL=https://lunarcrush.com
# GOPLUS_BASE_URL=https://api.gopluslabs.io
# HONEYPOT_BASE_URL=https://api.honeypot.is
# TELEGRAM_BASE_URL=https://api.telegram.org
#
# Single-endpoint overrides (full URL, placeholders included):
# COINGECKO_CONTRACT_URL=https://api.coingecko.com/api/v3/coins/{platform}/contract/{address}
# GECKOTERMINAL_POOL_OHLCV_URL=https://api.geckoterminal.com/api/v2/networks/{network}/pools/{pool}/ohlcv/{frame}
# SEC_COMPANY_FACTS_URL=https://data.sec.gov/api/xbrl/companyfacts/CIK{cik:010d}.json
#
# Blockscout explorers: one template for every chain, plus per-chain overrides
# (BLOCKSCOUT_BASE_URL_<CHAIN>) when a chain moves to its own instance.
# BLOCKSCOUT_EXPLORER_BASE_URL=https://{chain}.blockscout.com
# BLOCKSCOUT_BASE_URL_ETHEREUM=https://eth.blockscout.com
# BLOCKSCOUT_BASE_URL_BSC=https://bsc.blockscout.com
# BLOCKSCOUT_BASE_URL_POLYGON=https://polygon.blockscout.com
# BLOCKSCOUT_BASE_URL_ARBITRUM=https://arbitrum.blockscout.com
# BLOCKSCOUT_BASE_URL_BASE=https://base.blockscout.com

# --- Scanner layer credentials ----------------------------------------------
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
ETHERSCAN_API_KEY=
# Legacy alias for BLOCKSCOUT_BASE_URL_<DEFAULT_CHAIN>; still read.
# BLOCKSCOUT_BASE_URL=https://eth.blockscout.com

# --- Social layer (optional, layer degrades to SKIPPED when absent) ----------
LUNARCRUSH_API_KEY=
X_BEARER_TOKEN=

# --- Equity fundamentals (optional, layer degrades to SKIPPED when absent) ---
# SEC EDGAR's fair-access policy requires a contact address in the User-Agent.
# Set it to enable 10-K fundamentals for US-listed equities, e.g.
#   SEC_USER_AGENT=AlphaSentinel research@yourdomain.com
SEC_USER_AGENT=

# --- Alerting ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_SCORE=70                  # only alert on APPROVED verdicts >= this
ALERT_ON_VETO=true

# --- Scanner runtime ---------------------------------------------------------
SCAN_INTERVAL_SECONDS=300
TOKEN_CONCURRENCY=4
LAYER_TIMEOUT_SECONDS=20
HTTP_TIMEOUT_SECONDS=25
MAINTENANCE_INTERVAL_SECONDS=3600
# Container healthcheck window: a cycle older than this marks the bot unhealthy.
# 0 derives it from SCAN_INTERVAL_SECONDS (3x, minimum 1800s).
# HEALTH_MAX_STALE_SECONDS=1800
# Comma-separated layer slugs. Defaults cover every layer routed for the
# instrument's asset class (crypto has its own eight-layer manifest; listed
# markets use market/fundamentals/macro/technicals plus their class stub).
# Security is always on and cannot be disabled here.
# ENABLED_LAYERS=onchain,derivatives,social,dex,ecosystem,tokenomics,technicals,security,market,fundamentals,macro

# --- Dashboard ---------------------------------------------------------------
# The dashboard has no user accounts. Compose publishes it on loopback by
# default, so reaching it from another machine is a deliberate edit to
# DASHBOARD_BIND - and that edit needs a password in the same breath. The unlock
# form appears only when DASHBOARD_PASSWORD is non-empty.
# DASHBOARD_BIND=127.0.0.1
# DASHBOARD_PORT=8501
# DASHBOARD_PASSWORD=
